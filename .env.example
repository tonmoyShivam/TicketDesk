# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. Never commit real values.

# Session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-output-of-the-command-above

# Password for the local PostgreSQL container (docker compose) - pick your own.
LOCAL_DB_PASSWORD=choose-a-local-password

# Local database. Matches docker-compose.yml; put the same password in the URL.
DATABASE_URL=postgresql+psycopg://ticketdesk:choose-a-local-password@localhost:5432/ticketdesk
# Quickest possible trial with no PostgreSQL at all:
# DATABASE_URL=sqlite:///./ticketdesk.db

# Attachments go to ./uploads locally.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- On AWS these are set by the EC2 bootstrap instead (see docs/DEPLOYMENT.md) ----
# DB_HOST=<rds endpoint>
# DB_PORT=5432
# DB_NAME=ticketdesk
# DB_SECRET_ARN=<RDS-managed secret ARN>
# AWS_REGION=ap-south-1
# STORAGE_BACKEND=s3
# S3_BUCKET=<bucket name>
