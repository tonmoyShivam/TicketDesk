# Copy to terraform.tfvars (git-ignored) and fill in. No secrets belong here.
aws_region        = "ap-south-1"
repo_url          = "https://github.com/<owner>/<repo>.git"
repo_branch       = "main"
allowed_http_cidr = "203.0.113.10/32" # your IP: curl https://checkip.amazonaws.com

# Optional
# alert_email                 = "you@example.com"   # confirm the SNS email after apply
# github_repository           = "<owner>/<repo>"    # enables the GitHub Actions deploy role
# create_github_oidc_provider = true                # false if the account already has one
